# Copy to .env.test (git-ignored) and fill in. PLACEHOLDERS ONLY — never commit real values.
# See docs/security/SECRETS_AND_ACCOUNTS.md.

# Integration tests (Vitest) — a separate database that is emptied on every test.
# Put the admin URL in DATABASE_URL / E2E_DATABASE_URL once and run
# `npx tsx scripts/db-setup-roles.ts`: it replaces them with the least-privilege
# roles (ADR-029) and adds the MIGRATION_ / PORTAL_ lines.
DATABASE_URL="postgresql://orbit_runtime:CHANGE_ME@localhost:5433/orbitcargo_test?schema=public"
MIGRATION_DATABASE_URL="postgresql://orbit_owner:CHANGE_ME@localhost:5433/orbitcargo_test?schema=public"
PORTAL_DATABASE_URL="postgresql://orbit_portal:CHANGE_ME@localhost:5433/orbitcargo_test?schema=public"
NODE_ENV="test"
AUTH_SECRET="generate-a-long-random-value"

# E2E (Playwright) — its own database, so test accounts never touch real data.
# Generate the passwords randomly per machine:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
E2E_DATABASE_URL="postgresql://orbit_runtime:CHANGE_ME@localhost:5433/orbitcargo_e2e?schema=public"
E2E_MIGRATION_DATABASE_URL="postgresql://orbit_owner:CHANGE_ME@localhost:5433/orbitcargo_e2e?schema=public"
E2E_PORTAL_DATABASE_URL="postgresql://orbit_portal:CHANGE_ME@localhost:5433/orbitcargo_e2e?schema=public"
E2E_PASSWORD="generate-me"
E2E_CUSTOMER_PASSWORD="generate-me"
