# Copy to .env.test (git-ignored) and fill in. PLACEHOLDERS ONLY — never commit real values.
# See docs/security/SECRETS_AND_ACCOUNTS.md.

# Integration tests (Vitest) — a separate database that is TRUNCATED on every test.
DATABASE_URL="postgresql://orbit_app:CHANGE_ME@localhost:5433/orbitcargo_test?schema=public"
NODE_ENV="test"
AUTH_SECRET="generate-a-long-random-value"
DOCUMENTS_DIR="storage/test-documents"

# E2E (Playwright) — its own database, so test accounts never touch real data.
# Generate the passwords and MFA seed randomly per machine:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
#   node -e "console.log(require('otplib').authenticator.generateSecret())"
E2E_DATABASE_URL="postgresql://orbit_app:CHANGE_ME@localhost:5433/orbitcargo_e2e?schema=public"
E2E_PASSWORD="generate-me"
E2E_CUSTOMER_PASSWORD="generate-me"
E2E_MFA_SECRET="GENERATE_ME_BASE32"
