// OrbitCargo domain model (Phase 2).
// Derived from docs/architecture/DATA_MODEL_PLAN.md and the decisions log.
// Principles: normalized; decimal money/weights (ADR-004, USD); country+year
// scoping (ADR-002); append-only audit/events; no destructive cascades on
// financial/audit history (onDelete: Restrict). CHECK constraints that Prisma
// cannot express are added in the migration SQL (see prisma/migrations/).
//
// NOTE: charge-line canonical fields remain an OPEN decision (Phase 5). The
// ChargeLineItem below is intentionally generic (category/quantity/unitPrice/
// amount); the DS-specific fields (quality, brand, fatura, …) are added after
// confirmation so we don't bake in an unapproved structure.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ enums

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Department {
  MANAGEMENT
  OPERATIONS
  FINANCE
  CUSTOMER_SERVICE
  DOCUMENTS
  REPORTS
}

enum TransferRole {
  NONE
  SEND
  RECEIVE
}

enum AccessLevel {
  NONE
  VIEW
  EDIT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ShipmentMode {
  AIR
  SEA
  ROAD
}

// Operational status set (from the design system). Reconciliation with the
// customer-facing vocabulary in readme.md is an OPEN decision (Phase 4).
// Four operational statuses (ADR-017). IN_TRANSIT is shown as "Transit" and
// only applies to Air; Sea goes DEPARTED → ARRIVED. ARRIVED is terminal.
enum ShipmentStatus {
  AT_ORIGIN_STORE
  DEPARTED
  IN_TRANSIT
  ARRIVED
}

enum ShipmentEventType {
  SCAN
  MILESTONE
  DELAY
  EXCEPTION
  DELIVERY
  STATUS_CHANGE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum ChargeParentType {
  QUOTE
  INVOICE
}

enum ChargeCategory {
  FREIGHT
  BRAND
  FATURA
  LOCAL_DELIVERY
  CUSTOMS_TAX
  SERVICE
  OTHER
}

enum ReceiptDirection {
  IN
  OUT
}

// What a receipt documents (spec: every money movement in or out gets one).
enum ReceiptKind {
  PAYMENT
  EXPENSE
  SHIPMENT_COST
  COMMISSION
  TRANSFER
  DEBT
  DEBT_RETURN
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum DocumentKind {
  INVOICE
  IDENTITY
  CARGO_DOC
  OTHER
}

enum DocumentVisibility {
  PRIVATE
  CUSTOMER_VISIBLE
}

enum NotificationAudience {
  CUSTOMER
  ROLE
  ALL
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
}

// ------------------------------------------------------- identity & access

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String? // Argon2id; set on account setup
  status       UserStatus @default(INVITED)
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String? // TOTP secret, AES-256-GCM encrypted at rest
  // Bumped to invalidate all existing JWT sessions (password reset / forced
  // logout). The authorization layer compares this on every protected access.
  sessionEpoch Int        @default(0)
  lockedUntil  DateTime?

  // A user is EITHER staff (employee) OR a customer contact — enforced by a
  // CHECK constraint in the migration (not both set).
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  roles         UserRole[]
  auditEvents   AuditEvent[]         @relation("AuditActor")
  resetTokens   PasswordResetToken[]
  recoveryCodes MfaRecoveryCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Single-use MFA recovery codes. Only the hash is stored.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Password reset token. Only the HASH of the token is stored; the raw token is
// emailed once. Single-use (usedAt) and expiring (expiresAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Durable record of authentication attempts for rate limiting / lockout.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // email or reset identifier (lowercased)
  ip         String?
  kind       String // "login" | "reset"
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, kind, createdAt])
  @@index([ip, kind, createdAt])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "operation_admin"
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions   RolePermission[]
  users         UserRole[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "finance:write"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Role assignment, optionally scoped by country and/or business year (ADR-002).
// Null scope means the role applies globally.
model UserRole {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  country      String?
  businessYear Int?

  createdAt DateTime @default(now())

  @@unique([userId, roleId, country, businessYear])
  @@index([roleId])
}

model Employee {
  id           String       @id @default(cuid())
  code         String       @unique // EMP-###
  name         String
  phone        String?
  email        String?
  department   Department
  active       Boolean      @default(true)
  transferRole TransferRole @default(NONE)

  user       User?
  scopes     EmployeeScope[]
  pageAccess EmployeePageAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Country the employee is scoped to (e.g. Turkey, India). Used for transfer
// (trCountries) and general country scoping.
model EmployeeScope {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  country    String

  @@unique([employeeId, country])
}

// Per-employee page-level access override (ADR-002).
model EmployeePageAccess {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  page       String
  level      AccessLevel @default(NONE)

  @@unique([employeeId, page])
}

// ----------------------------------------------------------------- customers

model Customer {
  id              String         @id @default(cuid())
  ref             String         @unique // OR-####
  name            String
  company         String? // required for new customers (validated in the service)
  phone           String?
  // Digits-only phone used to reject duplicates (+252 61-555 0100 == 25261555 0100).
  phoneKey        String?        @unique
  email           String?        @unique // stored lowercased
  location        String? // free text (spec A1)
  cargoCategory   String? // "What do you buy?"
  country         String?
  status          CustomerStatus @default(ACTIVE)
  createdByUserId String?

  user          User?
  shipmentLines ShipmentLine[]
  quotes        Quote[]
  invoices      Invoice[]
  payments      Payment[]
  documents     Document[]
  notifications Notification[]
  receipts      Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ----------------------------------------------------------------- shipments

// A Shipment is a consolidation (W-<n> air / C-<n> sea). Customers attach via
// ShipmentLine. Code is unique within (businessYear, mode, originCountry);
// globally unique collision-resistant code enforced by @@unique on `code`.
model Shipment {
  id              String         @id @default(cuid())
  code            String         @unique
  trackingNumber  String?        @unique // generated in Phase 4
  mode            ShipmentMode
  originCountry   String
  originCity      String?
  destCountry     String?
  destCity        String?
  // Origin Code (city, e.g. IST / Istanbul) lives in originCity; destination code e.g. MGQ.
  destCode        String?
  shipDate        DateTime?      @db.Date
  arrivalDate     DateTime?      @db.Date // expected arrival
  status          ShipmentStatus @default(AT_ORIGIN_STORE)
  businessYear    Int
  departedAt      DateTime?
  arrivedAt       DateTime?
  createdByUserId String?

  airDetail  AirDetail?
  seaDetail  SeaDetail?
  roadDetail RoadDetail?
  lines      ShipmentLine[]
  events     ShipmentEvent[]
  quotes     Quote[]
  invoices   Invoice[]
  documents  Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessYear, mode, originCountry, code])
  @@index([status])
  @@index([businessYear])
}

model AirDetail {
  id                 String   @id @default(cuid())
  shipmentId         String   @unique
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  awbNumber          String?
  flightRef          String?
  chargeableWeightKg Decimal? @db.Decimal(12, 3)
  // AWB KG entered manually; shipment detail shows Total KG − AWB KG.
  awbKg              Decimal? @db.Decimal(12, 3)
}

model SeaDetail {
  id            String   @id @default(cuid())
  shipmentId    String   @unique
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  blNumber      String?
  containerRefs String[]
  volumeCbm     Decimal? @db.Decimal(12, 3)
}

model RoadDetail {
  id         String   @id @default(cuid())
  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vehicleRef String?
  driverRef  String?
  route      String?
}

// Cargo line associating a customer's goods with a consolidation shipment.
model ShipmentLine {
  id                 String   @id @default(cuid())
  shipmentId         String
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  description        String?
  packages           Int?
  chargeableWeightKg Decimal? @db.Decimal(12, 3)
  volumeCbm          Decimal? @db.Decimal(12, 3)
  // MIX: a box shared with other customers. Measure (air) = KG + MIX KG.
  mixCount           Int?
  mixKg              Decimal? @db.Decimal(12, 3)
  // Charges (ADR-013). Line total is computed server-side, never stored from the browser.
  rate               Decimal? @db.Decimal(14, 2) // per kg (air) / per CBM (sea)
  qualityRate        Decimal? @db.Decimal(14, 2) // per measure unit
  brandPcs           Int?
  brandRate          Decimal? @db.Decimal(14, 2)
  fatura             Decimal? @db.Decimal(14, 2)
  delivery           Decimal? @db.Decimal(14, 2)
  other              Decimal? @db.Decimal(14, 2)
  discount           Decimal? @db.Decimal(14, 2)
  note               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shipmentId])
  @@index([customerId])
}

// Append-only shipment scan/milestone history.
model ShipmentEvent {
  id             String            @id @default(cuid())
  shipmentId     String
  shipment       Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  type           ShipmentEventType
  status         ShipmentStatus?
  note           String?
  actorUserId    String?
  idempotencyKey String?           @unique
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  @@index([shipmentId, occurredAt])
}

// ------------------------------------------------------------------- finance

model Quote {
  id              String      @id @default(cuid())
  number          String?     @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipmentId      String?
  shipment        Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  currency        String      @default("USD")
  status          QuoteStatus @default(DRAFT)
  expiresAt       DateTime?
  total           Decimal     @default(0) @db.Decimal(14, 2)
  businessYear    Int?
  createdByUserId String?

  lines ChargeLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model Invoice {
  id               String        @id @default(cuid())
  number           String        @unique
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipmentId       String?
  shipment         Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  currency         String        @default("USD")
  status           InvoiceStatus @default(UNPAID)
  issuedAt         DateTime?
  // Authoritative total, recomputed server-side from line items (Phase 5).
  total            Decimal       @default(0) @db.Decimal(14, 2)
  amountAllocated  Decimal       @default(0) @db.Decimal(14, 2)
  // Subtracted from the sum of lines (shown above Total). total = lines − discount.
  discount         Decimal       @default(0) @db.Decimal(14, 2)
  // Spec B9 freight inputs (snapshot at invoicing). The customer only ever sees
  // the combined rate (rate + quality + agent commission).
  actualMeasure    Decimal?      @db.Decimal(12, 3)
  billedMeasure    Decimal?      @db.Decimal(12, 3)
  baseRate         Decimal?      @db.Decimal(14, 2)
  qualityRate      Decimal?      @db.Decimal(14, 2)
  agentName        String?
  agentRate        Decimal?      @db.Decimal(14, 2)
  // billedMeasure × agentRate — not shipment income; counts once fully paid.
  commissionAmount Decimal       @default(0) @db.Decimal(14, 2)
  businessYear     Int?
  createdByUserId  String?

  lines       ChargeLineItem[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

// Exactly one parent (quote XOR invoice) — enforced by CHECK in the migration.
model ChargeLineItem {
  id          String           @id @default(cuid())
  parentType  ChargeParentType
  quoteId     String?
  quote       Quote?           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  category    ChargeCategory
  description String?
  quantity    Decimal          @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal          @db.Decimal(14, 2)
  amount      Decimal          @db.Decimal(14, 2)
  currency    String           @default("USD")

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  method         PaymentMethod
  bankId         String?
  bank           Bank?         @relation(fields: [bankId], references: [id], onDelete: Restrict)
  reference      String?
  idempotencyKey String?       @unique
  receivedAt     DateTime      @default(now())
  actorUserId    String?
  // Reversal (no hard delete of financial history). Allocation rows are kept;
  // a reversed payment's allocations are excluded when recomputing invoices.
  reversedAt     DateTime?
  reversalReason String?

  allocations PaymentAllocation[]
  receipt     Receipt?

  createdAt DateTime @default(now())

  @@index([customerId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ----------------------------------------------------------------- documents

model Document {
  id               String             @id @default(cuid())
  kind             DocumentKind
  storageKey       String             @unique // server-generated, never the user filename
  filename         String? // sanitized original name, for display/download only
  contentType      String
  size             Int
  checksum         String?
  visibility       DocumentVisibility @default(PRIVATE)
  customerId       String?
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipmentId       String?
  shipment         Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  uploadedByUserId String?
  deletedAt        DateTime? // soft delete + retention

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([shipmentId])
}

// ------------------------------------------------------------- notifications

model Notification {
  id              String               @id @default(cuid())
  audience        NotificationAudience
  type            String?
  title           String
  message         String
  status          NotificationStatus   @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  roleId          String?
  role            Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdByUserId String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([customerId])
}

// ------------------------------------------------------------------ transfer

enum TransferStatus {
  PENDING
  SENT
  RECEIVED
  CANCELLED
}

// Inter-country cash/goods transfer (send/receive workflow). A SEND-role
// employee in the from-country creates and sends; a RECEIVE-role employee in
// the to-country marks it received.
model Transfer {
  id               String         @id @default(cuid())
  reference        String         @unique // TR-<year>-<seq>
  amount           Decimal        @db.Decimal(14, 2)
  currency         String         @default("USD")
  fromCountry      String
  toCountry        String
  status           TransferStatus @default(PENDING)
  note             String?
  businessYear     Int
  createdByUserId  String?
  sentByUserId     String?
  sentAt           DateTime?
  receivedByUserId String?
  receivedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fromCountry, toCountry, businessYear])
}

// ----------------------------------------------------------------- audit log

// Append-only. The application never updates or deletes rows here.
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

// ------------------------------------------------------- reference data (v2)

// Banks shown with their logos on invoices, receipts and payment forms.
model Bank {
  id            String  @id @default(cuid())
  name          String  @unique
  accountNumber String?
  logo          String? // public path, e.g. /banks/salaam.png
  isCash        Boolean @default(false)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  payments Payment[]
  receipts Receipt[]

  createdAt DateTime @default(now())
}

// Countries managed in Settings. Origin countries get separate shipments,
// finance and accounting; the flag comes from the ISO code.
model Country {
  id       String  @id @default(cuid())
  name     String  @unique
  iso2     String  @unique // lowercase, e.g. "tr"
  isOrigin Boolean @default(true)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
}

// Business years. Data is separated by year; a new year restarts W-1 / C-1.
model BusinessYear {
  year      Int      @id
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Numbered receipt for every money movement (RCP-<year>-<n>, n from 1001).
model Receipt {
  id           String           @id @default(cuid())
  number       String           @unique
  year         Int
  direction    ReceiptDirection
  kind         ReceiptKind
  amount       Decimal          @db.Decimal(14, 2)
  currency     String           @default("USD")
  bankId       String?
  bank         Bank?            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentId    String?          @unique
  payment      Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  counterparty String? // "Sent to" name + bank/phone for OUT receipts
  note         String?
  actorUserId  String?
  issuedAt     DateTime         @default(now())

  createdAt DateTime @default(now())

  @@index([year, kind])
  @@index([customerId])
}

// Per-year receipt counter, incremented atomically (row lock) inside the
// transaction that issues the receipt.
model ReceiptSequence {
  year Int @id
  next Int @default(1001)
}

// ---------------------------------------------------------- one-time codes

enum OtpPurpose {
  CUSTOMER_ACCESS // customer first login / forgotten password (Reference + Phone + Email)
  CUSTOMER_SIGNUP // "Create New Account"; the customer is created once the code verifies
  STAFF_SETUP // admin "Create Password": Employee ID + email → code
}

// Emailed 6-digit code. Only an HMAC of the code is stored; codes expire,
// are single-use, and lock after too many wrong attempts.
model OtpCode {
  id         String     @id @default(cuid())
  purpose    OtpPurpose
  email      String // lowercased destination
  userId     String? // set for CUSTOMER_ACCESS / STAFF_SETUP
  payload    Json? // CUSTOMER_SIGNUP form data (no secrets)
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose, createdAt])
}
