// OrbitCargo domain model (Phase 2).
// Derived from docs/architecture/DATA_MODEL_PLAN.md and the decisions log.
// Principles: normalized; decimal money/weights (ADR-004, USD); country+year
// scoping (ADR-002); append-only audit/events; no destructive cascades on
// financial/audit history (onDelete: Restrict). CHECK constraints that Prisma
// cannot express are added in the migration SQL (see prisma/migrations/).
//
// NOTE: charge-line canonical fields remain an OPEN decision (Phase 5). The
// ChargeLineItem below is intentionally generic (category/quantity/unitPrice/
// amount); the DS-specific fields (quality, brand, fatura, …) are added after
// confirmation so we don't bake in an unapproved structure.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ enums

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Department {
  MANAGEMENT
  OPERATIONS
  FINANCE
  CUSTOMER_SERVICE
  DOCUMENTS
  REPORTS
}

enum TransferRole {
  NONE
  SEND
  RECEIVE
}

enum AccessLevel {
  NONE
  VIEW
  EDIT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ShipmentMode {
  AIR
  SEA
  ROAD
}

// Operational status set (from the design system). Reconciliation with the
// customer-facing vocabulary in readme.md is an OPEN decision (Phase 4).
// Four operational statuses (ADR-017). IN_TRANSIT is shown as "Transit" and
// only applies to Air; Sea goes DEPARTED → ARRIVED. ARRIVED is terminal.
enum ShipmentStatus {
  AT_ORIGIN_STORE
  DEPARTED
  IN_TRANSIT
  ARRIVED
}

enum ShipmentEventType {
  SCAN
  MILESTONE
  DELAY
  EXCEPTION
  DELIVERY
  STATUS_CHANGE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum ChargeParentType {
  QUOTE
  INVOICE
}

enum ChargeCategory {
  FREIGHT
  BRAND
  FATURA
  LOCAL_DELIVERY
  CUSTOMS_TAX
  SERVICE
  OTHER
  QUALITY // quality-control charge per measure unit (shown as its own invoice line)
  DEMURRAGE // added only after an admin approves it (spec B9 Reminders)
}

enum ReminderKind {
  PAYMENT
  DEMURRAGE_WARNING
}

enum ReceiptDirection {
  IN
  OUT
}

// What a receipt documents (spec: every money movement in or out gets one).
enum ReceiptKind {
  PAYMENT
  EXPENSE
  SHIPMENT_COST
  COMMISSION
  TRANSFER
  DEBT
  DEBT_RETURN
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum DocumentKind {
  INVOICE
  IDENTITY
  CARGO_DOC
  OTHER
}

// Which paper of a shipment a document is (owner 2026-10-25): an air
// shipment has an origin AWB and a transit AWB; a container has one document.
enum ShipmentDocPart {
  ORIGIN_AWB
  TRANSIT_AWB
  CONTAINER
}

enum DocumentVisibility {
  PRIVATE
  CUSTOMER_VISIBLE
}

enum NotificationAudience {
  CUSTOMER
  ROLE
  ALL
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
}

// ------------------------------------------------------- identity & access

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String? // Argon2id; set on account setup
  status            UserStatus @default(INVITED)
  mfaEnabled        Boolean    @default(false)
  mfaSecret         String? // TOTP secret, AES-256-GCM encrypted at rest
  // Last 30-second TOTP step accepted: a code (and anything older) can never be reused.
  mfaLastStep       Int?
  // Bumped to invalidate all existing JWT sessions (password reset / forced
  // logout). The authorization layer compares this on every protected access.
  sessionEpoch      Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  // Accounting PIN (per user, hashed; spec §11 / owner answer Q4).
  accountingPinHash String?

  // A user is EITHER staff (employee) OR a customer contact — enforced by a
  // CHECK constraint in the migration (not both set).
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  roles         UserRole[]
  auditEvents   AuditEvent[]         @relation("AuditActor")
  resetTokens   PasswordResetToken[]
  recoveryCodes MfaRecoveryCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Single-use MFA recovery codes. Only the hash is stored.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Password reset token. Only the HASH of the token is stored; the raw token is
// emailed once. Single-use (usedAt) and expiring (expiresAt).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Durable record of authentication attempts for rate limiting / lockout.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // email or reset identifier (lowercased)
  ip         String?
  kind       String // "login" | "reset"
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, kind, createdAt])
  @@index([ip, kind, createdAt])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "operation_admin"
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions   RolePermission[]
  users         UserRole[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "finance:write"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Role assignment, optionally scoped by country and/or business year (ADR-002).
// Null scope means the role applies globally.
model UserRole {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  country      String?
  businessYear Int?

  createdAt DateTime @default(now())

  @@unique([userId, roleId, country, businessYear])
  @@index([roleId])
}

model Employee {
  id                String       @id @default(cuid())
  code              String       @unique // EMP-###
  name              String
  phone             String?
  email             String?
  department        Department
  active            Boolean      @default(true)
  transferRole      TransferRole @default(NONE)
  // Money Transfer countries (spec §5: Sender is usually Turkey only).
  transferCountries String[]     @default([])
  // Special access → Accounting (spec §5): only these users get the PIN screen.
  accountingAccess  Boolean      @default(false)
  // Access time window (spec §5): outside it the account has no permissions.
  accessFrom        DateTime?
  accessUntil       DateTime?

  user       User?
  scopes     EmployeeScope[]
  pageAccess EmployeePageAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Country the employee is scoped to (e.g. Turkey, India). Used for transfer
// (trCountries) and general country scoping.
model EmployeeScope {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  country    String

  @@unique([employeeId, country])
}

// Per-employee page-level access override (ADR-002).
model EmployeePageAccess {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  page       String
  level      AccessLevel @default(NONE)

  @@unique([employeeId, page])
}

// ----------------------------------------------------------------- customers

model Customer {
  id              String         @id @default(cuid())
  ref             String         @unique // OR-####
  name            String
  company         String? // required for new customers (validated in the service)
  phone           String?
  // Digits-only phone used to reject duplicates (+252 61-555 0100 == 25261555 0100).
  phoneKey        String?        @unique
  email           String?        @unique // stored lowercased
  location        String? // free text (spec A1)
  cargoCategory   String? // "What do you buy?"
  country         String?
  status          CustomerStatus @default(ACTIVE)
  createdByUserId String?

  user             User?
  shipmentLines    ShipmentLine[]
  quotes           Quote[]
  invoices         Invoice[]
  payments         Payment[]
  documents        Document[]
  notifications    Notification[]
  receipts         Receipt[]
  transferReceipts TransferReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ----------------------------------------------------------------- shipments

// A Shipment is a consolidation (W-<n> air / C-<n> sea). Customers attach via
// ShipmentLine. Code is unique within (businessYear, mode, originCountry);
// globally unique collision-resistant code enforced by @@unique on `code`.
model Shipment {
  id              String         @id @default(cuid())
  code            String         @unique
  trackingNumber  String?        @unique // generated in Phase 4
  mode            ShipmentMode
  originCountry   String
  originCity      String?
  destCountry     String?
  destCity        String?
  // Origin Code (city, e.g. IST / Istanbul) lives in originCity; destination code e.g. MGQ.
  destCode        String?
  shipDate        DateTime?      @db.Date
  arrivalDate     DateTime?      @db.Date // expected arrival
  status          ShipmentStatus @default(AT_ORIGIN_STORE)
  businessYear    Int
  departedAt      DateTime?
  arrivedAt       DateTime?
  createdByUserId String?

  airDetail  AirDetail?
  seaDetail  SeaDetail?
  roadDetail RoadDetail?
  lines      ShipmentLine[]
  events     ShipmentEvent[]
  quotes     Quote[]
  invoices   Invoice[]
  documents  Document[]
  costSheet  ShipmentCostSheet?
  cashOuts   CashOut[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessYear, mode, originCountry, code])
  @@index([status])
  @@index([businessYear])
}

model AirDetail {
  id                 String   @id @default(cuid())
  shipmentId         String   @unique
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  awbNumber          String?
  flightRef          String?
  chargeableWeightKg Decimal? @db.Decimal(12, 3)
  // AWB KG entered manually; shipment detail shows Total KG − AWB KG.
  awbKg              Decimal? @db.Decimal(12, 3)
}

model SeaDetail {
  id            String   @id @default(cuid())
  shipmentId    String   @unique
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  blNumber      String?
  containerRefs String[]
  volumeCbm     Decimal? @db.Decimal(12, 3)
}

model RoadDetail {
  id         String   @id @default(cuid())
  shipmentId String   @unique
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vehicleRef String?
  driverRef  String?
  route      String?
}

// Cargo line associating a customer's goods with a consolidation shipment.
model ShipmentLine {
  id                 String    @id @default(cuid())
  shipmentId         String
  shipment           Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  description        String?
  packages           Int?
  chargeableWeightKg Decimal?  @db.Decimal(12, 3)
  volumeCbm          Decimal?  @db.Decimal(12, 3)
  // MIX: a box shared with other customers. Measure (air) = KG + MIX KG.
  mixCount           Int?
  mixKg              Decimal?  @db.Decimal(12, 3)
  // Charges (ADR-013). Line total is computed server-side, never stored from the browser.
  rate               Decimal?  @db.Decimal(14, 2) // per kg (air) / per CBM (sea)
  qualityRate        Decimal?  @db.Decimal(14, 2) // per measure unit
  brandPcs           Int?
  brandRate          Decimal?  @db.Decimal(14, 2)
  fatura             Decimal?  @db.Decimal(14, 2)
  delivery           Decimal?  @db.Decimal(14, 2)
  other              Decimal?  @db.Decimal(14, 2)
  discount           Decimal?  @db.Decimal(14, 2)
  note               String?
  // Demurrage (spec B9 Reminders): cargo collected at MGQ stops the clock;
  // extra free days are granted per customer line by Finance.
  collectedAt        DateTime?
  extraFreeDays      Int       @default(0)
  // Shipments → customer list "Notification": last update sent to the customer.
  notifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shipmentId])
  @@index([customerId])
}

// Append-only shipment scan/milestone history.
model ShipmentEvent {
  id             String            @id @default(cuid())
  shipmentId     String
  shipment       Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  type           ShipmentEventType
  status         ShipmentStatus?
  note           String?
  actorUserId    String?
  idempotencyKey String?           @unique
  occurredAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  @@index([shipmentId, occurredAt])
}

// ------------------------------------------------------------------- finance

model Quote {
  id              String      @id @default(cuid())
  number          String?     @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipmentId      String?
  shipment        Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  currency        String      @default("USD")
  status          QuoteStatus @default(DRAFT)
  expiresAt       DateTime?
  total           Decimal     @default(0) @db.Decimal(14, 2)
  businessYear    Int?
  createdByUserId String?

  lines ChargeLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model Invoice {
  id               String        @id @default(cuid())
  number           String        @unique
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipmentId       String?
  shipment         Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  currency         String        @default("USD")
  status           InvoiceStatus @default(UNPAID)
  issuedAt         DateTime?
  // Authoritative total, recomputed server-side from line items (Phase 5).
  total            Decimal       @default(0) @db.Decimal(14, 2)
  amountAllocated  Decimal       @default(0) @db.Decimal(14, 2)
  // Subtracted from the sum of lines (shown above Total). total = lines − discount.
  discount         Decimal       @default(0) @db.Decimal(14, 2)
  // Spec B9 freight inputs (snapshot at invoicing). The customer only ever sees
  // the combined rate (rate + quality + agent commission).
  actualMeasure    Decimal?      @db.Decimal(12, 3)
  billedMeasure    Decimal?      @db.Decimal(12, 3)
  baseRate         Decimal?      @db.Decimal(14, 2)
  qualityRate      Decimal?      @db.Decimal(14, 2)
  agentName        String?
  agentRate        Decimal?      @db.Decimal(14, 2)
  // billedMeasure × agentRate — not shipment income; counts once fully paid.
  commissionAmount Decimal       @default(0) @db.Decimal(14, 2)
  businessYear     Int?
  createdByUserId  String?

  lines              ChargeLineItem[]
  allocations        PaymentAllocation[]
  revisions          InvoiceRevision[]
  reminders          PaymentReminder[]
  commissionPayments CommissionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One live (non-VOID) invoice per customer per shipment: partial unique
  // index "Invoice_shipment_customer_live_key" in migration 20261024090000.
  @@index([customerId])
  @@index([status])
  @@index([shipmentId])
}

// Invoice History → Invoice changes (spec B9). Append-only: one row per changed
// field, with the before/after shown to staff exactly as stored.
model InvoiceRevision {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  field       String // English label key, e.g. "Rate (USD)"
  before      String
  after       String
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([createdAt])
}

// Reminders sent from Finance (payment reminder / demurrage warning). Penalties
// are never added here; an approved demurrage is a DEMURRAGE invoice line.
model PaymentReminder {
  id             String       @id @default(cuid())
  kind           ReminderKind
  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  shipmentId     String
  customerId     String
  notificationId String?
  actorUserId    String?
  createdAt      DateTime     @default(now())

  @@index([shipmentId, customerId, kind])
  @@index([invoiceId])
}

// Exactly one parent (quote XOR invoice) — enforced by CHECK in the migration.
model ChargeLineItem {
  id          String           @id @default(cuid())
  parentType  ChargeParentType
  quoteId     String?
  quote       Quote?           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  category    ChargeCategory
  description String?
  quantity    Decimal          @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal          @db.Decimal(14, 2)
  amount      Decimal          @db.Decimal(14, 2)
  currency    String           @default("USD")

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  method         PaymentMethod
  bankId         String?
  bank           Bank?         @relation(fields: [bankId], references: [id], onDelete: Restrict)
  reference      String?
  idempotencyKey String?       @unique
  receivedAt     DateTime      @default(now())
  actorUserId    String?
  // Reversal (no hard delete of financial history). Allocation rows are kept;
  // a reversed payment's allocations are excluded when recomputing invoices.
  reversedAt     DateTime?
  reversalReason String?

  allocations PaymentAllocation[]
  receipt     Receipt?

  createdAt DateTime @default(now())

  @@index([customerId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ----------------------------------------------------------------- documents

model Document {
  id               String             @id @default(cuid())
  kind             DocumentKind
  storageKey       String             @unique // server-generated, never the user filename
  filename         String? // sanitized original name, for display/download only
  reference        String? // staff-typed document reference (spec §13), e.g. a packing list no.
  contentType      String
  size             Int
  checksum         String?
  visibility       DocumentVisibility @default(PRIVATE)
  customerId       String?
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipmentId       String?
  shipment         Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shipmentPart     ShipmentDocPart? // set for "Upload Shipment" documents
  uploadedByUserId String?
  deletedAt        DateTime? // soft delete + retention

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([shipmentId])
}

// ------------------------------------------------------------- notifications

model Notification {
  id              String               @id @default(cuid())
  audience        NotificationAudience
  type            String?
  title           String
  message         String
  status          NotificationStatus   @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  roleId          String?
  role            Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdByUserId String?
  // Schedule Announcement (spec §9): last day, flight/departure date, origin,
  // destination; an optional image kept in private storage.
  details         Json?
  imageKey        String?
  imageType       String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([customerId])
}

// ------------------------------------------------------------------ transfer

enum TransferStatus {
  PENDING
  SENT
  RECEIVED
  CANCELLED
}

// Inter-country cash/goods transfer (send/receive workflow). A SEND-role
// employee in the from-country creates and sends; a RECEIVE-role employee in
// the to-country marks it received.
model Transfer {
  id               String         @id @default(cuid())
  reference        String         @unique // TR-<year>-<seq>
  amount           Decimal        @db.Decimal(14, 2)
  currency         String         @default("USD")
  fromCountry      String
  toCountry        String
  status           TransferStatus @default(PENDING)
  note             String?
  businessYear     Int
  createdByUserId  String?
  sentByUserId     String?
  sentAt           DateTime?
  receivedByUserId String?
  receivedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fromCountry, toCountry, businessYear])
}

// ----------------------------------------------------------------- audit log

// Append-only. The application never updates or deletes rows here.
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

// ------------------------------------------------------- reference data (v2)

// Banks shown with their logos on invoices, receipts and payment forms.
model Bank {
  id            String  @id @default(cuid())
  name          String  @unique
  accountNumber String?
  logo          String? // public path, e.g. /banks/salaam.png
  isCash        Boolean @default(false)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  payments       Payment[]
  receipts       Receipt[]
  cashOuts       CashOut[]
  debtReturns    DebtReturn[]
  cashCounts     CashCount[]
  openingEntries OpeningEntry[]

  createdAt DateTime @default(now())
}

// Countries managed in Settings. Origin countries get separate shipments,
// finance and accounting; the flag comes from the ISO code.
model Country {
  id       String  @id @default(cuid())
  name     String  @unique
  iso2     String  @unique // lowercase, e.g. "tr"
  isOrigin Boolean @default(true)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
}

// Business years. Data is separated by year; a new year restarts W-1 / C-1.
model BusinessYear {
  year      Int      @id
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Numbered receipt for every money movement (RCP-<year>-<n>, n from 1001).
model Receipt {
  id           String           @id @default(cuid())
  number       String           @unique
  year         Int
  direction    ReceiptDirection
  kind         ReceiptKind
  amount       Decimal          @db.Decimal(14, 2)
  currency     String           @default("USD")
  bankId       String?
  bank         Bank?            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentId    String?          @unique
  payment      Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  counterparty String? // "Sent to" name + bank/phone for OUT receipts
  note         String?
  actorUserId  String?
  issuedAt     DateTime         @default(now())
  // Set when the money movement was reversed (e.g. a payment corrected or
  // deleted in Finance). The receipt is kept for the audit trail.
  reversedAt   DateTime?
  cashOut      CashOut?
  debtReturn   DebtReturn?

  createdAt DateTime @default(now())

  @@index([year, kind])
  @@index([customerId])
}

// Per-year receipt counter, incremented atomically (row lock) inside the
// transaction that issues the receipt.
model ReceiptSequence {
  year Int @id
  next Int @default(1001)
}

// ---------------------------------------------------------- one-time codes

enum OtpPurpose {
  CUSTOMER_ACCESS // customer first login / forgotten password (Reference + Phone + Email)
  CUSTOMER_SIGNUP // "Create New Account"; the customer is created once the code verifies
  STAFF_SETUP // admin "Create Password": Employee ID + email → code
}

// Emailed 6-digit code. Only an HMAC of the code is stored; codes expire,
// are single-use, and lock after too many wrong attempts.
model OtpCode {
  id         String     @id @default(cuid())
  purpose    OtpPurpose
  email      String // lowercased destination
  userId     String? // set for CUSTOMER_ACCESS / STAFF_SETUP
  payload    Json? // CUSTOMER_SIGNUP form data (no secrets)
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose, createdAt])
}

// Settings (spec §16) that admins edit: company profile, general, notification
// switches. One JSON value per section key.
model AppSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------------------ Accounting (Phase 16, spec §11)

enum CostStage {
  ORIGIN
  TRANSIT // Air only
  ARRIVED // always Mogadishu (MGQ)
}

enum OutCategory {
  SHIPMENT_COST
  EXPENSE
  COMMISSION
  TRANSFER
  DEBT
  PROFIT_PAYOUT // ADR-019
}

enum Partner {
  SOMALI_TRANSPORT
  MAHAD
}

enum ClosePeriod {
  H1
  H2
  YEAR
}

// Per-shipment cost sheets. `origin` is filled by the origin-country staff,
// `mgq` by the Somalia staff; every derived figure is computed on the server.
model ShipmentCostSheet {
  shipmentId      String   @id
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  origin          Json     @default("{}")
  mgq             Json     @default("{}")
  originUpdatedBy String?
  mgqUpdatedBy    String?
  updatedAt       DateTime @updatedAt
}

// Every payment out of a country's money (Income & Out → + Add Out). Each one
// has a receipt; a correction reverses it instead of deleting it.
model CashOut {
  id          String      @id @default(cuid())
  country     String
  year        Int
  category    OutCategory
  shipmentId  String?
  shipment    Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  stage       CostStage?
  partner     Partner?
  bankId      String
  bank        Bank        @relation(fields: [bankId], references: [id], onDelete: Restrict)
  sentTo      String? // recipient name (printed on the receipt)
  sentVia     String? // how it was sent: a bank, EVC Plus, Zaad, cash … (owner 2026-10-25)
  sentAccount String? // the recipient's account or phone number
  amount      Decimal     @db.Decimal(14, 2)
  // Paid now for an earlier year (owner 2026-10-24), e.g. 2025 shipment W-30:
  // it comes out of what that year left in the opening balance, once.
  forYear     Int?
  reference   String? // e.g. "W-30" when the shipment is not in the system
  paidAt      DateTime
  note        String?
  receiptId   String      @unique
  receipt     Receipt     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorUserId String?
  reversedAt  DateTime?
  createdAt   DateTime    @default(now())

  commissions CommissionPayment[]
  returns     DebtReturn[]

  @@index([country, year, category])
  @@index([shipmentId])
}

// One commission payout can settle several invoices' commissions.
model CommissionPayment {
  id        String  @id @default(cuid())
  cashOutId String
  cashOut   CashOut @relation(fields: [cashOutId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
}

// Money returned on a debt (an Out → Debt, or a debt carried from an earlier
// year as an OpeningEntry). Posts to Income. Exactly one of the two is set.
model DebtReturn {
  id             String        @id @default(cuid())
  cashOutId      String?
  cashOut        CashOut?      @relation(fields: [cashOutId], references: [id], onDelete: Restrict)
  openingEntryId String?
  openingEntry   OpeningEntry? @relation(fields: [openingEntryId], references: [id], onDelete: Restrict)
  amount         Decimal       @db.Decimal(14, 2)
  bankId         String
  bank           Bank          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  returnedAt     DateTime
  receiptId      String        @unique
  receipt        Receipt       @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorUserId    String?
  createdAt      DateTime      @default(now())

  @@index([cashOutId])
  @@index([openingEntryId])
}

// The admin's count of what is in each bank / cash for a country (checked
// against the computed balance).
model CashCount {
  id          String   @id @default(cuid())
  country     String
  bankId      String
  bank        Bank     @relation(fields: [bankId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(14, 2)
  countedAt   DateTime @default(now())
  actorUserId String?

  @@index([country, bankId, countedAt])
}

// Period closing: a closed period can't be changed (Finance or Accounting).
model PeriodClose {
  id          String      @id @default(cuid())
  country     String
  year        Int
  period      ClosePeriod
  fromDate    DateTime
  toDate      DateTime
  closedAt    DateTime    @default(now())
  actorUserId String?
  // A Super Admin may reopen a period of a system year (2026 onward). The row
  // is kept; at most one live (not reopened) close per country, year, period
  // (partial unique index in the migration).
  reopenedAt  DateTime?
  reopenedBy  String?

  @@index([country, year, period])
}

// Balance carried into a new year (from the previous year's closing balance).
// Balance brought forward from earlier years, one line per source (owner
// 2026-10-24). Typed by the admin for years before the system, or written
// when the previous year is closed (carried = true). Corrections reverse a
// line; nothing is deleted. Legacy OpeningBalance rows still count.
enum OpeningSource {
  PROFIT
  TRANSFER
  COMMISSION
  SOMALI_TRANSPORT
  MAHAD
  DEBT
  SHIPMENT_COST
  OTHER
}

// How an earlier year is entered (owner 2026-10-24): first its TOTAL balance,
// then where it is (BANK lines) and what it is (SOURCE lines). Both splits must
// add up to the total. DEBT lines are money owed to us, outside the balance.
enum OpeningLineKind {
  TOTAL
  BANK
  SOURCE
  DEBT
}

model OpeningEntry {
  id          String          @id @default(cuid())
  country     String
  year        Int // the year this balance opens
  fromYear    Int // the year it came from
  kind        OpeningLineKind @default(SOURCE)
  source      OpeningSource? // SOURCE and DEBT lines
  amount      Decimal         @db.Decimal(14, 2) // + we hold it, − we owe / lost; DEBT: owed to us (> 0, not in the balance)
  bankId      String? // BANK lines (null = not in a bank, only when carried)
  bank        Bank?           @relation(fields: [bankId], references: [id], onDelete: Restrict)
  person      String? // DEBT: who owes us
  note        String?
  carried     Boolean         @default(false)
  actorUserId String?
  reversedAt  DateTime?
  reversedBy  String?
  createdAt   DateTime        @default(now())

  returns DebtReturn[]

  @@index([country, year])
}

model OpeningBalance {
  country     String
  year        Int
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  actorUserId String?

  @@id([country, year])
}

// ------------------------------------------------------------------ Money Transfer (Phase 17, spec §12)

enum TransferKind {
  CUSTOMER // money customers send to people
  OPERATION // origin-cost money only; a record, not income
}

enum TransferTag {
  CLOTHES
  MEDICINE
  OTHER
}

enum TransferSendStatus {
  PAID
  PENDING
}

// One row of the Money Status Report. The Receiver fills the left side and
// hands the money to the Sender (orange → green); only then can the Sender
// record the right side. Rows are soft-deleted.
model MoneyTransferRow {
  id             String              @id @default(cuid())
  country        String
  year           Int
  month          Int
  kind           TransferKind
  receivedAt     DateTime            @db.Date
  amount         Decimal             @db.Decimal(14, 2) // total received
  feePct         Decimal             @default(0) @db.Decimal(5, 2)
  currency       String              @default("USD")
  description    String
  tag            TransferTag?
  receiverUserId String?
  handedAt       DateTime?
  sentAt         DateTime?           @db.Date
  sentAmount     Decimal?            @db.Decimal(14, 2) // taken from the customer
  sentCurrency   String?
  sentStatus     TransferSendStatus?
  senderUserId   String?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  receipts       TransferReceipt[]

  @@index([country, year, month, kind])
}

// Receipt Voucher for money a customer hands over to be transferred (owner
// 2026-10-25). Numbered 5000, 5001, … per year. With a customer reference it is
// shown in that customer's Documents. One live receipt per transfer row
// (partial unique index); a wrong one is voided and a new one made.
model TransferReceipt {
  id            String            @id @default(cuid())
  year          Int
  number        Int
  country       String
  transferRowId String?
  transferRow   MoneyTransferRow? @relation(fields: [transferRowId], references: [id], onDelete: Restrict)
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivedFrom  String // the customer's name (top of the paper)
  receivedAt    DateTime          @db.Date
  amount        Decimal           @db.Decimal(14, 2) // to send (after the fee)
  fee           Decimal?          @db.Decimal(14, 2) // optional; shown only when typed
  currency      String            @default("USD")
  description   String // where it goes, e.g. "TO SINA"
  actorUserId   String
  voidedAt      DateTime?
  voidedBy      String?
  createdAt     DateTime          @default(now())

  @@unique([year, number])
  @@index([customerId])
  @@index([transferRowId])
}

model TransferReceiptSequence {
  year Int @id
  next Int @default(1)
}

// "Start new month": months opened on the report (per country + year).
model TransferMonth {
  country     String
  year        Int
  month       Int
  openedAt    DateTime @default(now())
  actorUserId String?

  @@id([country, year, month])
}
