# OrbitCargo environment variables — PLACEHOLDERS ONLY. Never commit a real .env.
# Copy to .env.local for development. Values here are examples, not secrets.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database — least-privilege credentials per environment.
# Local dev uses the dedicated Docker Postgres on port 5433 (see docs/DATABASE.md).
DATABASE_URL=postgresql://orbit_app:CHANGE_ME@localhost:5433/orbitcargo?schema=public
# Integration tests use a separate database (see .env.test):
# DATABASE_URL=postgresql://orbit_app:CHANGE_ME@localhost:5433/orbitcargo_test?schema=public

# Auth (Phase 3)
# AUTH_SECRET=generate-a-long-random-value
# AUTH_URL=http://localhost:3000

# Object storage for private documents (Phase 6)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
