# OrbitCargo environment variables — PLACEHOLDERS ONLY. Never commit a real .env.
# Copy to .env.local for development. Values here are examples, not secrets.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database — three least-privilege roles (ADR-029). Don't type these by hand:
# put the server admin in DATABASE_URL once, then run
#   npx tsx scripts/db-setup-roles.ts
# It creates the roles with random passwords and rewrites the lines below.
# Local dev uses the dedicated Docker Postgres on port 5433 (see docs/DATABASE.md).
DATABASE_ADMIN_URL=postgresql://orbit_app:CHANGE_ME@localhost:5433/orbitcargo?schema=public
DATABASE_URL=postgresql://orbit_runtime:CHANGE_ME@localhost:5433/orbitcargo?schema=public
MIGRATION_DATABASE_URL=postgresql://orbit_owner:CHANGE_ME@localhost:5433/orbitcargo?schema=public
PORTAL_DATABASE_URL=postgresql://orbit_portal:CHANGE_ME@localhost:5433/orbitcargo?schema=public
# Production: the app gets DATABASE_URL + PORTAL_DATABASE_URL only; the
# MIGRATION_DATABASE_URL lives with the deploy step, DATABASE_ADMIN_URL nowhere on the server.

# Auth (Phase 3) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=generate-a-long-random-value
AUTH_URL=http://localhost:3000

# Transactional email (Resend). mail.orbitcargo.org is the verified sending
# domain; use a "Sending access" key limited to it. Production requires all
# three, and EMAIL_FROM must send from EMAIL_DOMAIN (checked at boot).
# (Development without EMAIL_FROM falls back to onboarding@resend.dev, which
# only delivers to the Resend account owner.)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_DOMAIN=mail.orbitcargo.org
EMAIL_FROM=OrbitCargo <noreply@mail.orbitcargo.org>

# Limits on emailed sign-in codes (optional; defaults shown).
# All code emails together, per hour (raise for a planned onboarding day):
OTP_EMAIL_HOURLY_CAP=60
# Code requests per client IP per 15 minutes:
OTP_IP_MAX_PER_15MIN=10

# Reverse proxies in front of the app whose X-Forwarded-For entry is trusted.
# 0 = none (local development: per-IP limits are skipped). Production: 1
# (Caddy/Nginx on the VPS; required). The proxy must append or overwrite
# X-Forwarded-For with the real client address.
TRUSTED_PROXY_HOPS=0

# Documents and announcement images are stored in PostgreSQL (ADR-030).
# DOCUMENTS_DIR is only read by scripts/move-files-to-db.ts, to copy files from
# the old folder storage (default storage/documents).
# DOCUMENTS_DIR=storage/documents

